<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dcpay - Official Payment Portal</title>
    <!-- QR Code Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #87CEEB 0%, #4682B4 50%, #003366 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            background: rgba(255, 255, 255, 0.95);
            width: 90%;
            max-width: 450px;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            text-align: center;
        }

        /* Logo Section */
        .logo {
            font-size: 40px;
            font-weight: 900;
            color: #0056b3;
            letter-spacing: 2px;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        .tagline {
            color: #87CEEB;
            font-size: 14px;
            margin-bottom: 20px;
            font-weight: bold;
            letter-spacing: 1px;
        }

        /* QR Code Section */
        .qr-section {
            background: #f4f8fc;
            border: 2px dashed #87CEEB;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
        }

        #qrcode {
            display: inline-block;
            background: white;
            padding: 10px;
            border-radius: 10px;
        }

        /* Payment Details Section */
        .payment-options {
            background: #e6f2ff;
            border-radius: 15px;
            padding: 15px;
            margin-bottom: 20px;
        }

        .payment-title {
            font-size: 18px;
            color: #003366;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .methods {
            display: flex;
            justify-content: space-around;
            gap: 10px;
        }

        .method-btn {
            background: #0056b3;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            transition: 0.3s;
            width: 30%;
        }

        .method-btn:hover {
            background: #003366;
            transform: translateY(-2px);
        }

        .method-btn.active {
            background: #87CEEB;
            color: #003366;
        }

        /* Input and Button */
        input {
            width: 100%;
            padding: 12px;
            border: 2px solid #87CEEB;
            border-radius: 8px;
            margin-bottom: 10px;
            outline: none;
        }

        input:focus {
            border-color: #0056b3;
        }

        button.pay-btn {
            width: 100%;
            background: linear-gradient(90deg, #0056b3, #87CEEB);
            color: white;
            border: none;
            padding: 15px;
            border-radius: 10px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        button.pay-btn:hover {
            opacity: 0.9;
            transform: scale(1.02);
        }

        .hidden {
            display: none;
        }

        #success-msg {
            color: green;
            margin-top: 10px;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Logo -->
        <div class="logo">Dcpay</div>
        <div class="tagline">Secure. Fast. Trusted.</div>

        <!-- QR Code Section -->
        <div class="qr-section">
            <h3 style="color: #0056b3; margin-bottom: 10px;">Scan to Pay & Open Website</h3>
            <div id="qrcode"></div>
        </div>

        <!-- Payment Methods -->
        <div class="payment-options">
            <div class="payment-title">Select Payment Method</div>
            <div class="methods">
                <button class="method-btn active" onclick="selectMethod('UPI')">UPI</button>
                <button class="method-btn" onclick="selectMethod('Card')">Card</button>
                <button class="method-btn" onclick="selectMethod('NetBanking')">NetBanking</button>
            </div>
        </div>

        <!-- Payment Details Form -->
        <input type="text" id="upi-id" placeholder="Enter UPI ID (e.g., name@upi)">
        <input type="text" id="amount" placeholder="Enter Amount (₹)">
        
        <!-- Pay Button -->
        <button class="pay-btn" onclick="processPayment()">Proceed to Pay</button>

        <p id="success-msg" class="hidden"></p>
    </div>

    <script>
        // 1. QR Code Generation (Ye QR code usi page ko open karega)
        const currentUrl = window.location.href;
        new QRCode(document.getElementById("qrcode"), {
            text: currentUrl,
            width: 200,
            height: 200,
            colorDark : "#003366",
            colorLight : "#ffffff",
            correctLevel : QRCode.CorrectLevel.H
        });

        // 2. Payment Method Selection
        function selectMethod(method) {
            const buttons = document.querySelectorAll('.method-btn');
            buttons.forEach(btn => btn.classList.remove('active'));
            
            // Highlight the clicked button
            event.target.classList.add('active');
            
            // Change placeholder based on method
            const input = document.getElementById('upi-id');
            if (method === 'UPI') {
                input.placeholder = "Enter UPI ID (e.g., name@upi)";
            } else if (method === 'Card') {
                input.placeholder = "Enter Card Number (e.g., 1234 5678 9012)";
            } else {
                input.placeholder = "Enter Bank Account Number";
            }
        }

        // 3. Payment Processing (Demo functionality)
        function processPayment() {
            const upi = document.getElementById('upi-id').value;
            const amount = document.getElementById('amount').value;

            if (!upi || !amount) {
                alert("Please enter all payment details.");
                return;
            }

            // Fake processing delay
            const payBtn = document.querySelector('.pay-btn');
            payBtn.innerText = "Processing...";
            payBtn.disabled = true;

            setTimeout(() => {
                payBtn.innerText = "Proceed to Pay";
                payBtn.disabled = false;
                
                // Show success message
                const msg = document.getElementById('success-msg');
                msg.classList.remove('hidden');
                msg.innerText = `Payment of ₹${amount} successful via ${document.querySelector('.method-btn.active').innerText}!`;
                
                // Reset inputs
                document.getElementById('upi-id').value = '';
                document.getElementById('amount').value = '';
            }, 2000);
        }
    </script>

</body>
</html>
